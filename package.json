{
  "name": "customer-api",
  "version": "1.0.0",
  "description": "Insurance policy data service in JavaScript (NestJS 11 + Fastify): worker-thread CSV/XLSX import, policy search and per-user aggregation, CPU-based auto-restart, scheduled message inserts.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "babel src --out-dir dist --delete-dir-on-start",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --watch --env-file-if-exists=.env --require @babel/register src/main.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand test/unit",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand test/e2e",
    "demo:cpu": "node --env-file-if-exists=.env scripts/demo-cpu-restart.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv-parse": "^7.0.3",
    "joi": "^18.2.9",
    "luxon": "^3.7.2",
    "mongoose": "^9.10.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@nestjs/testing": "^11.2.6",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
