# Copy to .env and adjust. Every variable is validated at startup (src/config/configuration.js).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Comma-separated allow-list; empty = CORS off (never '*')
CORS_ORIGINS=
LOG_LEVEL=info

MONGO_URI=mongodb://127.0.0.1:27017
# Database name — used even if MONGO_URI names a different one
MONGO_DB_NAME=customer
# Build the schema indexes (incl. the unique natural keys) at startup
MONGO_AUTO_INDEX=true

# Task 2.1 — the primary process supervises WEB_CONCURRENCY server workers
CLUSTER_ENABLED=true
WEB_CONCURRENCY=1

# Task 1.1 — uploads and the worker-thread import
UPLOAD_MAX_BYTES=10485760
IMPORT_BATCH_SIZE=1000
IMPORT_MAX_CONCURRENCY=2
IMPORT_TIMEOUT_MS=120000

# Task 2.1 — CPU supervisor (100 % = one core fully busy, like `top`)
CPU_SAMPLE_MS=1000
CPU_THRESHOLD_PCT=70
CPU_SUSTAIN_SAMPLES=3
CPU_HEARTBEAT_TIMEOUT_MS=5000
CPU_WARMUP_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
RESTART_MAX=5
RESTART_WINDOW_MS=60000

# Task 2.2 — scheduled messages
APP_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=1000
SCHEDULER_BATCH=50
SCHEDULER_LOCK_TTL_MS=30000
SCHEDULER_MAX_ATTEMPTS=5

# POST /api/debug/cpu-burn (demo of Task 2.1). Keep false outside local testing.
ENABLE_DEBUG_ROUTES=false
